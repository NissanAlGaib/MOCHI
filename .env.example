# Copy to .env and fill in. .env is gitignored - never commit real keys.
# mochi-gateway reads the .env in the folder it is started from.
# Step-by-step setup: docs/SETUP.md.

# --- Target LLM (the model MOCHI protects) ---
# Which provider MOCHI forwards to: openai, anthropic or gemini. Independent
# of which SDK the application uses - an Anthropic SDK app can be served by an
# OpenAI-compatible model, and the other way round.
TARGET_LLM_PROVIDER=openai

# Default model used when a client request does not specify one, and the model
# used whenever the client's SDK belongs to a different provider than this one
# (its model name would mean nothing here).
TARGET_LLM_MODEL=gpt-4o-mini

# --- OpenAI adapter (also any OpenAI-compatible server: Ollama, vLLM, ...) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic adapter ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Gemini adapter (GOOGLE_API_KEY is read too) ---
# GEMINI_API_KEY=your-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Gateway ---
MOCHI_HOST=127.0.0.1
MOCHI_PORT=8000

# Upstream request timeout in seconds.
MOCHI_REQUEST_TIMEOUT=60

# --- Telemetry ---
# JSON Lines file. The Phase 5/13 evaluation harness reads this to produce the
# Chapter IV results tables.
MOCHI_LOG_PATH=logs/mochi.jsonl

# Persist raw prompt text in the log. OFF by default: routine operation records
# only a SHA-256 hash and length, per the thesis Ethical Considerations
# commitment on anonymization. Turn ON only for controlled evaluation runs over
# public benchmark datasets, never against real user traffic.
MOCHI_LOG_PAYLOADS=false

# --- Tagalog translation layer (disabled by design) ---
# Word-level Tagalog -> English substitution before detection. Off, and it
# should stay off: measured on 250 held-out code-switched samples it LOWERED
# recall (100% -> 97.6%) and RAISED the false-positive rate 2.5x
# (1.60% -> 4.00%). The lexicon does not preserve grammar, so it feeds the
# detector degraded English. multilingual-e5-small is pretrained on Tagalog and
# handles code-switched text directly - Taglish scored 100% recall against a
# 98.4% English baseline, so there is nothing for this layer to fix.
# Retained as an ablation arm. See reports/taglish_ablation.json.
MOCHI_ENABLE_TAGALOG_TRANSLATION=false

# --- Image inspection (off by default) ---
# OCR inline images before detection. Without this, a payload rendered as
# pixels is invisible to every stage: the detector reads an empty string and
# allows the request. Measured on one request with a concealed payload -
#   off: stage2 0.009 ALLOW     on: stage2 0.932 BLOCK
# Costs ~1.8s per image against ~200ms for the rest of inspection, and needs
# rapidocr_onnxruntime, so it is opt-in. Only inline data: images are read;
# remote URLs are never fetched.
MOCHI_READ_IMAGES=false

# An attachment carried in the request that could not be read (an executable,
# an archive, a corrupt file): block | strip | allow | auto. auto strips it
# (replaces it with a marker) when MOCHI_FORWARD_MODE=convert, and blocks the
# request when MOCHI_FORWARD_MODE=inspect, where the model would otherwise
# receive bytes nothing checked. Applies only while MOCHI_READ_IMAGES is on.
MOCHI_UNREADABLE_ATTACHMENTS=auto

# --- Declared secrets (optional) ---
# A file of strings that must never appear in a response, one per line
# (passwords, API keys, internal codes; lines starting with # are ignored).
# Removed wherever they occur - as written, spelled out with separators,
# reversed, or base64/hex-encoded. The 8-word leak check cannot see a short
# secret; this can. Paraphrase and translation are still out of reach.
# MOCHI_PROTECTED_SECRETS_FILE=secrets.txt
