# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- Target LLM (the model MOCHI protects) ---
# Which provider adapter to route through. Phase 1 ships "openai";
# "anthropic" / "gemini" adapters land in Phase 12.
TARGET_LLM_PROVIDER=openai

# Default model used when a client request does not specify one.
TARGET_LLM_MODEL=gpt-4o-mini

# --- OpenAI adapter ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gateway ---
MOCHI_HOST=127.0.0.1
MOCHI_PORT=8000

# Upstream request timeout in seconds.
MOCHI_REQUEST_TIMEOUT=60

# --- Telemetry ---
# JSON Lines file. The Phase 5/13 evaluation harness reads this to produce the
# Chapter IV results tables.
MOCHI_LOG_PATH=logs/mochi.jsonl

# Persist raw prompt text in the log. OFF by default: routine operation records
# only a SHA-256 hash and length, per the thesis Ethical Considerations
# commitment on anonymization. Turn ON only for controlled evaluation runs over
# public benchmark datasets, never against real user traffic.
MOCHI_LOG_PAYLOADS=false
